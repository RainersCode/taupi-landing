---
import "~/styles/global.css";
import SmoothScroll from "~/components/SmoothScroll";
import Seo from "~/components/Seo.astro";
import Analytics from "@vercel/analytics/astro";
import type { Locale } from "~/i18n/strings";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Force-disable hreflang. Usually unnecessary — see Seo.astro. */
  alternate?: boolean;
  ogType?: "website" | "article";
  /** Page-specific OG image path — see Seo.astro. */
  ogImage?: string;
  /** Keep out of the index, keep following links — see Seo.astro. */
  noindex?: boolean;
  /** Trail below home, e.g. [{ name: "Kalkulatori", href: "/kalkulatori/" }]. */
  breadcrumbs?: { name: string; href: string }[];
  /** Extra JSON-LD nodes merged into the @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = "Taupi — zini, kur aiziet tava nauda.",
  locale,
  alternate,
  ogType = "website",
  ogImage,
  noindex = false,
  breadcrumbs,
  schema,
} = Astro.props;

// Fonts (Sora / DM Sans / JetBrains Mono, matching the RN app's type stack)
// are self-hosted via @fontsource imports in global.css — no render-blocking
// Google Fonts request.
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EFE9FA" />


    <Seo
      title={title}
      description={description}
      locale={locale}
      alternate={alternate}
      ogType={ogType}
      ogImage={ogImage}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      schema={schema}
    />

    <!-- Ikona = lietotnes ikona (zils fons, balts gredzens). Google meklēšana
         izvēlas rastru, kura mala dalās ar 48, un izgriež to aplī — tāpēc
         fons iet līdz malām. Avots: public/favicon.svg; PNG/ICO no tā. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Cookieless visit counting (Vercel Web Analytics) — no trackers,
         in line with the privacy promise. -->
    <Analytics />

    <!-- Page-specific head extras (preloads etc.) -->
    <slot name="head" />
  </head>
  <body>
    <SmoothScroll client:load />
    <slot />
  </body>
</html>
