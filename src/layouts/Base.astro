---
import "~/styles/global.css";
import SmoothScroll from "~/components/SmoothScroll";
import Seo from "~/components/Seo.astro";
import type { Locale } from "~/i18n/strings";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
}

const { title, description = "Taupi — zini, kur aiziet tava nauda.", locale } = Astro.props;

// Fonts (Sora / DM Sans / JetBrains Mono, matching the RN app's type stack)
// are self-hosted via @fontsource imports in global.css — no render-blocking
// Google Fonts request.
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D1128" />

    <Seo title={title} description={description} locale={locale} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Page-specific head extras (preloads etc.) -->
    <slot name="head" />
  </head>
  <body>
    <SmoothScroll client:load />
    <slot />
  </body>
</html>
