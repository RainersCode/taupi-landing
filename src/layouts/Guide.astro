---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ToolGhostIcon from "~/components/ToolGhostIcon.astro";
import { getDict } from "~/i18n/strings";
import { author } from "~/config";
import { path } from "~/i18n/routes";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

/**
 * Guide shell — a topic hub whose H2 sections are the individual
 * sub-guides. The TOC is built from those headings, so every sub-guide
 * is anchor-linkable and the app can open /gids/<id>/#<sub-guide>
 * directly. Reading column + typography mirror BlogPost; images render
 * as phone-framed screenshots (see the style block below).
 *
 * Indexable since 2026-09-08. Until the stores went live these were
 * noindexed on purpose — they documented an app nobody could install, so they
 * drew no searches while eating ~30% of the crawl budget (Google parked 8 of
 * the 10 in "discovered, not indexed"). Taupi is now in both stores, so the
 * guides are the site's strongest Latvian search surface and go back into the
 * index together with the sitemap entry (see astro.config.mjs).
 */
interface Props {
  guide: CollectionEntry<"gids">;
  headings: MarkdownHeading[];
}

const { guide, headings } = Astro.props;
const { title, description, updatedDate, locale, tools } = guide.data;
const t = getDict(locale);

// "Noderīgi rīki" — the calculators this guide's frontmatter points at. The
// guides were the site's only pages with no path down to /kalkulatori/, which
// is how ten indexed pages ended up passing nothing to the tools they
// describe. Anchor text is each tool's real title, never "šeit".
const relatedTools = tools.map((key) => ({
  key,
  href: path(key, locale),
  title: t[`tools.${key}.title`],
  desc: t[`tools.${key}.desc`],
}));

const site = Astro.site ?? new URL("https://taupi.eu");
const canonical = new URL(Astro.url.pathname, site).href;

// H2 headings only — those are the sub-guides; deeper levels are steps.
const toc = headings.filter((h) => h.depth === 2);

const displayDate = updatedDate.toLocaleDateString(locale === "lv" ? "lv-LV" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: locale,
  dateModified: updatedDate.toISOString(),
  mainEntityOfPage: canonical,
  image: new URL("/og.jpg", site).href,
  author: { "@id": `${site.href}#${author.name ? "author" : "org"}` },
  publisher: { "@id": `${site.href}#org` },
};
---
<Base
  title={`${title} — Taupi`}
  description={description}
  locale={locale}
  alternate={false}
  ogType="article"
  breadcrumbs={[
    { name: t["nav.gids"], href: "/gids/" },
    { name: title, href: Astro.url.pathname },
  ]}
>
  <Nav locale={locale} />

  <main class="mx-auto max-w-3xl px-6 md:px-10 pt-36 md:pt-40 pb-24">
    <header class="mb-12 border-b border-frost/10 pb-10">
      <p class="eyebrow mb-6">
        <a href="/gids/" class="hover:text-ink transition-colors">← {t["gids.back"]}</a>
      </p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(32px, 4.5vw, 60px); letter-spacing: -0.035em; line-height: 1.05;"
      >
        {title}
      </h1>
      <p class="mt-6 text-dim max-w-[58ch] text-lg" style="line-height: 1.65;">
        {description}
      </p>
      <p class="mt-6 eyebrow text-muted">{t["gids.updated"]} {displayDate}</p>
    </header>

    {toc.length > 1 && (
      <nav class="mb-14 rounded-2xl border border-frost/10 bg-frost/[0.03] p-7" aria-label={t["gids.toc"]}>
        <p class="eyebrow mb-5">{t["gids.toc"]}</p>
        <ol class="space-y-3">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-dim hover:text-accent transition-colors">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <article class="legal-prose guide-prose">
      <slot />
    </article>

    {relatedTools.length > 0 && (
      <aside class="mt-16 border-t border-frost/10 pt-10" aria-labelledby="gids-tools">
        <p class="eyebrow mb-5" id="gids-tools">{t["gids.tools"]}</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedTools.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="group relative overflow-hidden block h-full rounded-2xl border border-frost/10 bg-frost/[0.03] p-5 hover:border-accent/15 hover:bg-frost/[0.05] transition-colors"
              >
                {/* Ghost ikona fonā — vienotais karšu raksts. */}
                <ToolGhostIcon tool={tool.key} size={150} class="-right-8 -top-8" />
                <span
                  class="relative block font-display font-bold text-ink text-[16px] group-hover:text-accent transition-colors"
                  style="letter-spacing: -0.01em; line-height: 1.3;"
                >
                  {tool.title}
                </span>
                <span class="relative mt-2 block text-[13.5px] text-dim" style="line-height: 1.5;">
                  {tool.desc}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <p class="mt-16 border-t border-frost/10 pt-8">
      <a href="/gids/" class="eyebrow text-dim hover:text-ink transition-colors">← {t["gids.back"]}</a>
    </p>
  </main>

  <Footer locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style is:global>
  /* Sub-guide headings get scroll room under the fixed nav. */
  .guide-prose h2 {
    scroll-margin-top: 7rem;
  }
  /* Screenshots render as phone frames: narrow, rounded, hairline border. */
  .guide-prose img {
    display: block;
    margin: 1.5rem auto;
    max-width: min(320px, 100%);
    border-radius: 1.25rem;
    border: 1px solid rgb(var(--frost-rgb) / 0.12);
  }
  /* Screenshot placeholder — a blockquote whose first text is 📷 reads as
     a dashed drop-slot until the real image replaces it. */
  .guide-prose blockquote {
    border: 1px dashed rgb(var(--frost-rgb) / 0.2);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    color: rgb(var(--frost-rgb) / 0.55);
  }
  /* Visual steps: ordered lists render as numbered indigo circles — the
     app's own accent — so the action sequence reads at a glance. */
  .guide-prose ol {
    list-style: none;
    counter-reset: step;
    padding-left: 0;
    margin: 1.25rem 0;
  }
  /* Dubultā specifika ar nolūku: global.css atdod ol>li markerus atpakaļ
     (.legal-prose ol > li { list-style: decimal } — Tailwind preflight
     labojums juridiskajām lapām), un tas uzvarēja pār mūsu list-style uz
     ol. Gida raksts nes ABAS klases, tāpēc šeit vajag abu klašu ķēdi —
     citādi mobilajā blakus indigo aplītim rādās arī pārlūka "1.". */
  .legal-prose.guide-prose ol > li {
    list-style: none;
  }
  .guide-prose ol > li {
    counter-increment: step;
    position: relative;
    padding-left: 3.4rem;
    margin: 1.1rem 0;
    line-height: 1.6;
  }
  .guide-prose ol > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.15rem;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Pilns brand aplis ar baltu ciparu — kā lietotnē; blāvā tinte ar
       #aab4ff ciparu gaišajā tēmā nebija salasāma. */
    background: var(--brand);
    border: none;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }
  /* UI-element convention: `code` inside a guide is a BUTTON/LABEL from the
     app, rendered as an app-style pill chip (not monospace). */
  .guide-prose code {
    display: inline-block;
    padding: 0.05rem 0.65rem;
    border-radius: 9999px;
    /* Pilns brand pill ar baltu tekstu — kā pogas lietotnē; caurspīdīgais
       variants ar #f5f5f7 tekstu gaišajā tēmā pazuda. */
    background: rgb(var(--brand-rgb) / 0.92);
    border: none;
    color: #fff;
    font-family: inherit;
    font-size: 0.88em;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
