---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { getDict } from "~/i18n/strings";
import { author } from "~/config";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

/**
 * Guide shell — a topic hub whose H2 sections are the individual
 * sub-guides. The TOC is built from those headings, so every sub-guide
 * is anchor-linkable and the app can open /gids/<id>/#<sub-guide>
 * directly. Reading column + typography mirror BlogPost; images render
 * as phone-framed screenshots (see the style block below).
 *
 * NOINDEXED until launch. These document an app nobody can install yet, so
 * they attract no searches while consuming ~30% of the crawl budget — which
 * is why Google left 8 of the 10 in "discovered, not indexed". They stay
 * fully reachable for humans and keep `follow`, so link equity still flows.
 * Remove `noindex` here and in gids/index.astro on launch day, and drop the
 * sitemap filter in astro.config.mjs.
 */
interface Props {
  guide: CollectionEntry<"gids">;
  headings: MarkdownHeading[];
}

const { guide, headings } = Astro.props;
const { title, description, updatedDate, locale } = guide.data;
const t = getDict(locale);

const site = Astro.site ?? new URL("https://taupi.eu");
const canonical = new URL(Astro.url.pathname, site).href;

// H2 headings only — those are the sub-guides; deeper levels are steps.
const toc = headings.filter((h) => h.depth === 2);

const displayDate = updatedDate.toLocaleDateString(locale === "lv" ? "lv-LV" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: locale,
  dateModified: updatedDate.toISOString(),
  mainEntityOfPage: canonical,
  image: new URL("/og.jpg", site).href,
  author: { "@id": `${site.href}#${author.name ? "author" : "org"}` },
  publisher: { "@id": `${site.href}#org` },
};
---
<Base
  title={`${title} — Taupi`}
  description={description}
  locale={locale}
  alternate={false}
  ogType="article"
  noindex
  breadcrumbs={[
    { name: t["nav.gids"], href: "/gids/" },
    { name: title, href: Astro.url.pathname },
  ]}
>
  <Nav locale={locale} />

  <main class="mx-auto max-w-3xl px-6 md:px-10 pt-36 md:pt-40 pb-24">
    <header class="mb-12 border-b border-white/10 pb-10">
      <p class="eyebrow mb-6">
        <a href="/gids/" class="hover:text-ink transition-colors">← {t["gids.back"]}</a>
      </p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(32px, 4.5vw, 60px); letter-spacing: -0.035em; line-height: 1.05;"
      >
        {title}
      </h1>
      <p class="mt-6 text-dim max-w-[58ch] text-lg" style="line-height: 1.65;">
        {description}
      </p>
      <p class="mt-6 eyebrow text-muted">{t["gids.updated"]} {displayDate}</p>
    </header>

    {toc.length > 1 && (
      <nav class="mb-14 rounded-2xl border border-white/10 bg-white/[0.03] p-7" aria-label={t["gids.toc"]}>
        <p class="eyebrow mb-5">{t["gids.toc"]}</p>
        <ol class="space-y-3">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-dim hover:text-accent transition-colors">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <article class="legal-prose guide-prose">
      <slot />
    </article>

    <p class="mt-16 border-t border-white/10 pt-8">
      <a href="/gids/" class="eyebrow text-dim hover:text-ink transition-colors">← {t["gids.back"]}</a>
    </p>
  </main>

  <Footer locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style is:global>
  /* Sub-guide headings get scroll room under the fixed nav. */
  .guide-prose h2 {
    scroll-margin-top: 7rem;
  }
  /* Screenshots render as phone frames: narrow, rounded, hairline border. */
  .guide-prose img {
    display: block;
    margin: 1.5rem auto;
    max-width: min(320px, 100%);
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  /* Screenshot placeholder — a blockquote whose first text is 📷 reads as
     a dashed drop-slot until the real image replaces it. */
  .guide-prose blockquote {
    border: 1px dashed rgb(255 255 255 / 0.2);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    color: rgb(255 255 255 / 0.55);
  }
  /* Visual steps: ordered lists render as numbered indigo circles — the
     app's own accent — so the action sequence reads at a glance. */
  .guide-prose ol {
    list-style: none;
    counter-reset: step;
    padding-left: 0;
    margin: 1.25rem 0;
  }
  .guide-prose ol > li {
    counter-increment: step;
    position: relative;
    padding-left: 3.4rem;
    margin: 1.1rem 0;
    line-height: 1.6;
  }
  .guide-prose ol > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.15rem;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(90 107 255 / 0.16);
    border: 1px solid rgb(90 107 255 / 0.45);
    color: #aab4ff;
    font-weight: 700;
    font-size: 0.95rem;
  }
  /* UI-element convention: `code` inside a guide is a BUTTON/LABEL from the
     app, rendered as an app-style pill chip (not monospace). */
  .guide-prose code {
    display: inline-block;
    padding: 0.05rem 0.65rem;
    border-radius: 9999px;
    background: rgb(90 107 255 / 0.18);
    border: 1px solid rgb(255 255 255 / 0.16);
    color: #f5f5f7;
    font-family: inherit;
    font-size: 0.88em;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
