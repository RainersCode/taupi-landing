---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import Seo from "~/components/Seo.astro";

/**
 * Layout for legal/legal-adjacent pages — Privacy, Terms, etc.
 *
 * Narrow reading column, high-contrast typography, mono metadata at the top.
 * Matches the main site's dark navy theme so users don't feel like they
 * landed on a different brand when they click "Privacy Policy".
 */
interface Props {
  frontmatter: {
    title: string;
    description?: string;
    updated?: string;
    version?: string;
    locale?: "lv" | "en";
  };
}

const { frontmatter } = Astro.props;
const locale = frontmatter.locale ?? "lv";
const description = frontmatter.description ?? `${frontmatter.title} — Taupi`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D1128" />

    <Seo
      title={`${frontmatter.title} — Taupi`}
      description={description}
      locale={locale}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Nav locale={locale} />

    <main class="mx-auto max-w-3xl px-6 md:px-10 pt-36 md:pt-40 pb-24">
      <!-- Title + metadata header -->
      <header class="mb-16 border-b border-white/10 pb-10">
        <p class="eyebrow mb-6">
          <a href={locale === "lv" ? "/" : "/en/"} class="hover:text-ink transition-colors">
            ← {locale === "lv" ? "Sākums" : "Home"}
          </a>
        </p>
        <h1
          class="font-display font-extrabold text-ink"
          style="font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.035em; line-height: 1.02;"
        >
          {frontmatter.title}
        </h1>
        {(frontmatter.updated || frontmatter.version) && (
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
            {frontmatter.updated && (
              <span class="eyebrow text-muted">
                {locale === "lv" ? "Atjaunināts" : "Updated"} · {frontmatter.updated}
              </span>
            )}
            {frontmatter.version && (
              <span class="eyebrow text-muted">
                v{frontmatter.version}
              </span>
            )}
          </div>
        )}
      </header>

      <!-- Markdown body — styled via `prose` utility below -->
      <article class="legal-prose">
        <slot />
      </article>
    </main>

    <Footer locale={locale} />
    <!-- Long-form typography (.legal-prose) lives in global.css — shared
         with the blog (BlogPost.astro). -->
  </body>
</html>
