---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { getDict } from "~/i18n/strings";
import type { CollectionEntry } from "astro:content";

/**
 * Blog post shell — same reading column + .legal-prose typography as the
 * legal pages, plus BlogPosting JSON-LD. The signup funnel lives in the
 * footer's newsletter band (no in-page CTA — two adjacent forms read as
 * broken). Posts are LV-only for now, so hreflang alternates are disabled.
 */
interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, locale } = post.data;
const t = getDict(locale);

const site = Astro.site ?? new URL("https://taupi.eu");
const canonical = new URL(Astro.url.pathname, site).href;

const displayDate = pubDate.toLocaleDateString(locale === "lv" ? "lv-LV" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  inLanguage: locale,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: canonical,
  image: new URL("/og.jpg", site).href,
  author: { "@id": `${site.href}#org` },
  publisher: { "@id": `${site.href}#org` },
};

---
<Base title={`${title} — Taupi`} description={description} locale={locale} alternate={false} ogType="article">
  <Nav locale={locale} />

  <main class="mx-auto max-w-3xl px-6 md:px-10 pt-36 md:pt-40 pb-24">
    <header class="mb-16 border-b border-white/10 pb-10">
      <p class="eyebrow mb-6">
        <a href="/padomi/" class="hover:text-ink transition-colors">← {t["blog.back"]}</a>
      </p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(32px, 4.5vw, 60px); letter-spacing: -0.035em; line-height: 1.05;"
      >
        {title}
      </h1>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        <span class="eyebrow text-muted">{displayDate}</span>
        {post.data.tags.length > 0 && (
          <span class="eyebrow text-muted">{post.data.tags.join(" · ")}</span>
        )}
      </div>
    </header>

    <article class="legal-prose">
      <slot />
    </article>
  </main>

  <Footer locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
