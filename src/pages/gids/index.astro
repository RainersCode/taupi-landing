---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { getCollection } from "astro:content";
import { getDict } from "~/i18n/strings";

/**
 * Guide index — /gids/. The app's "Palīdzība" entry points here; each
 * guide is a topic hub with anchor-linkable sub-guides. Ordered by the
 * `order` frontmatter (task frequency, not date — guides are evergreen).
 */
const locale = "lv" as const;
const t = getDict(locale);

const guides = (
  await getCollection("gids", ({ data }) => !data.draft && data.locale === "lv")
).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Taupi lietošanas gids — soli pa solim pamācības"
  description="Soli pa solim pamācības Taupi lietotnei: budžeta iestatīšana, periodi, mērķi, parādi, čeku skenēšana un vairāk. Ar ekrānuzņēmumiem, latviski."
  locale={locale}
  alternate={false}
>
  <Nav locale={locale} />

  <main class="mx-auto max-w-3xl px-6 md:px-10 pt-36 md:pt-40 pb-24">
    <header class="mb-16 border-b border-white/10 pb-10">
      <p class="eyebrow mb-6">{t["gids.eyebrow"]}</p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.035em; line-height: 1.02;"
      >
        {t["gids.title"]}
      </h1>
      <p class="mt-8 text-dim max-w-[52ch] text-lg" style="line-height: 1.65;">
        {t["gids.intro"]}
      </p>
    </header>

    <div>
      {guides.map((guide, i) => (
        <article class="group border-b border-white/10 py-10 first:pt-0">
          <div class="flex items-baseline gap-5">
            <span class="eyebrow text-muted shrink-0">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h2
                class="font-display font-bold text-ink"
                style="font-size: clamp(20px, 2.4vw, 28px); letter-spacing: -0.02em; line-height: 1.25;"
              >
                <a href={`/gids/${guide.id}/`} class="hover:text-accent transition-colors">
                  {guide.data.title}
                </a>
              </h2>
              <p class="mt-3 text-dim max-w-[62ch]" style="line-height: 1.65;">
                {guide.data.description}
              </p>
              <div class="mt-5">
                <a
                  href={`/gids/${guide.id}/`}
                  class="eyebrow text-accent hover:text-ink transition-colors"
                >
                  {t["gids.open"]} →
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
</Base>
