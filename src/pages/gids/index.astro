---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import SideRail from "~/components/SideRail.astro";
import { getCollection } from "astro:content";
import { getDict } from "~/i18n/strings";
import {
  Wallet,
  CalendarRange,
  Target,
  HandCoins,
  ScanLine,
  ArrowLeftRight,
  CircleGauge,
  Users,
  LayoutGrid,
  Sparkles,
} from "@lucide/astro";

/**
 * Guide index — /gids/. A task hub, not a blog: users come to DO one
 * thing, so guides render as a compact card grid grouped by intent
 * (help-center pattern — Stripe/Intercom style) instead of the padomi
 * editorial list. Ordered by the `order` frontmatter within groups.
 */
const locale = "lv" as const;
const t = getDict(locale);

const guides = (
  await getCollection("gids", ({ data }) => !data.draft && data.locale === "lv")
).sort((a, b) => a.data.order - b.data.order);

// Card icon per guide id — library icons only, mirroring the app's own
// iconography (wallet, target, scan frame, transfer arrows...).
const ICONS: Record<string, any> = {
  "budzeta-iestatijumi": Wallet,
  "jauns-periods": CalendarRange,
  merki: Target,
  paradi: HandCoins,
  "ceku-skenesana": ScanLine,
  "konti-un-parskaitijumi": ArrowLeftRight,
  "sakuma-ekrans": CircleGauge,
  "koplietots-budzets": Users,
  logriki: LayoutGrid,
  "ai-ieskati-un-kvotas": Sparkles,
};

const groups: Array<{ key: "pamati" | "ikdiena"; label: string }> = [
  { key: "pamati", label: t["gids.group.pamati"] },
  { key: "ikdiena", label: t["gids.group.ikdiena"] },
];

// Sānjosla: jaunākie padomu raksti — gids atbild "kā izdarīt",
// padomi atbild "kāpēc un cik".
const fmtDate = (d: Date) =>
  d.toLocaleDateString("lv-LV", { year: "numeric", month: "long", day: "numeric" });
const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.locale === "lv")
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    href: `/padomi/${post.id}/`,
    title: post.data.title,
    desc: post.data.description,
    meta: fmtDate(post.data.pubDate),
  }));
---
<Base
  title="Taupi lietošanas gids — soli pa solim pamācības"
  description="Soli pa solim pamācības Taupi lietotnei: budžeta iestatīšana, periodi, mērķi, parādi, čeku skenēšana un vairāk. Ar ekrānuzņēmumiem, latviski."
  locale={locale}
  alternate={false}
  breadcrumbs={[{ name: t["nav.gids"], href: "/gids/" }]}
>
  <Nav locale={locale} />

  <main class="relative mx-auto max-w-content px-6 md:px-10 pt-36 md:pt-40 pb-24">
    {/* Kluss brand mirdzums aiz galvenes — kā padomi/jaunumi lapās. */}
    <div
      aria-hidden
      class="pointer-events-none absolute -top-16 left-0 h-[480px] w-full max-w-[900px]"
      style="background: radial-gradient(closest-side, rgba(90,107,255,0.12) 0%, rgb(var(--bg-rgb) / 0) 100%);"
    >
    </div>
    <header class="relative mb-14 border-b border-frost/10 pb-10">
      <p class="eyebrow mb-6">{t["gids.eyebrow"]}</p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.035em; line-height: 1.02;"
      >
        {t["gids.title"]}
      </h1>
      <p class="mt-8 text-dim max-w-[52ch] text-lg" style="line-height: 1.65;">
        {t["gids.intro"]}
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_330px] gap-14 lg:gap-16 items-start">
    <div>
    {groups.map((group) => {
      const items = guides.filter((g) => g.data.group === group.key);
      if (items.length === 0) return null;
      return (
        <section class="mb-14">
          <p class="eyebrow mb-6">{group.label}</p>
          <div class="grid gap-5 sm:grid-cols-2">
            {items.map((guide) => {
              const Icon = ICONS[guide.id];
              return (
                <a
                  href={`/gids/${guide.id}/`}
                  class="group relative overflow-hidden rounded-2xl border border-frost/10 bg-frost/[0.03] p-6 hover:border-accent/15 hover:bg-frost/[0.05] transition-colors"
                >
                  {/* Ghost ikona fonā — tas pats raksts, kas sākumlapas
                      Iespēju kartēm: liela balta kontūra ~6% caurspīdīgumā
                      ar pārkari pāri augšējo labo stūri, saturs pa virsu. */}
                  {Icon && (
                    <Icon
                      size={180}
                      stroke-width={1}
                      aria-hidden="true"
                      class="pointer-events-none absolute -right-10 -top-8 text-ink opacity-[0.06]"
                    />
                  )}
                  <span
                    class="relative block font-display font-bold text-ink group-hover:text-accent transition-colors"
                    style="font-size: 17px; letter-spacing: -0.01em; line-height: 1.3;"
                  >
                    {guide.data.title}
                  </span>
                  <span class="relative mt-2 block text-dim text-sm" style="line-height: 1.55;">
                    {guide.data.description}
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
    </div>

    <SideRail
      eyebrow={t["blog.eyebrow"]}
      items={posts}
      moreHref="/padomi/"
      moreLabel={t["blog.back"]}
    />
    </div>
  </main>

  <Footer locale={locale} />
</Base>
