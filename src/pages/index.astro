---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Hero from "~/components/Hero";
import LifestylePanel from "~/components/LifestylePanel";
import ProductReveal from "~/components/ProductReveal";
import FeatureGrid from "~/components/FeatureGrid";
import TrustPanel from "~/components/TrustPanel.astro";
import Faq from "~/components/Faq.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import Footer from "~/components/Footer.astro";

const locale = "lv" as const;
---
<Base
  title="Taupi — personīgo finanšu un budžeta lietotne"
  description="Zini, kur aiziet tava nauda. Budžets, čeku skenēšana ar AI, ieskati un uzkrājumu mērķi vienuviet — radīta Latvijā. Lejupielādē App Store vai Google Play."
  locale={locale}
>
  <!-- Hero phone screenshot = desktop LCP. Preload it early on desktop;
       on mobile the phone is display:none and never gets fetched. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/screens/sakums.webp"
    media="(min-width: 768px)"
    fetchpriority="high"
  />
  <Nav locale={locale} />

  <main>
    <!-- Sticky-stacking intro on all viewports. Mobile uses smaller
         PhoneFrame instances to fit 100vh; see Hero.tsx + ProductReveal.tsx. -->
    <div class="relative h-[200vh]">
      <div class="w-full sticky top-0 h-screen overflow-hidden" style="z-index: 10;">
        <Hero locale={locale} client:load />
      </div>
      <div class="w-full sticky top-0 h-screen overflow-hidden" style="z-index: 20;">
        <LifestylePanel locale={locale} client:visible />
      </div>
    </div>

    <ProductReveal locale={locale} client:visible />

    <FeatureGrid locale={locale} client:visible />

    <TrustPanel locale={locale} />

    <Faq locale={locale} />

    <DownloadCTA locale={locale} />
  </main>

  <Footer locale={locale} newsletter={false} />
</Base>
