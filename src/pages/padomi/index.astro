---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import SideRail from "~/components/SideRail.astro";
import { getCollection } from "astro:content";
import { getDict } from "~/i18n/strings";
import { path } from "~/i18n/routes";

/**
 * Blog listing — /padomi/. LV-only for now (alternate={false}), so no
 * hreflang pair is emitted until an /en/ mirror exists.
 */
const locale = "lv" as const;
const t = getDict(locale);

const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.locale === "lv")
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("lv-LV", { year: "numeric", month: "long", day: "numeric" });

// Sānjoslas kalkulatori — raksti bieži beidzas ar "izrēķini pats".
const toolItems = (["budget", "compound", "emergency", "debt"] as const).map((key) => ({
  href: path(key, locale),
  title: t[`tools.${key}.title`],
  desc: t[`tools.${key}.desc`],
}));
---
<Base
  title="Padomi par naudu, budžetu un taupīšanu — Taupi"
  description="Praktiski padomi latviski: kā ietaupīt naudu, plānot budžetu un sekot līdzi izdevumiem ikdienā. No Taupi — Latvijā radītas finanšu lietotnes — komandas."
  locale={locale}
  alternate={false}
  breadcrumbs={[{ name: t["blog.eyebrow"], href: "/padomi/" }]}
>
  <Nav locale={locale} />

  <main class="relative mx-auto max-w-content px-6 md:px-10 pt-36 md:pt-40 pb-24">
    {/* Kluss brand mirdzums aiz galvenes — tas pats dziļums, kas sākumlapas
        hero, lai satura lapu augša nav pliks teksts uz plakana fona. */}
    <div
      aria-hidden
      class="pointer-events-none absolute -top-16 left-0 h-[480px] w-full max-w-[900px]"
      style="background: radial-gradient(closest-side, rgba(90,107,255,0.12) 0%, rgb(var(--bg-rgb) / 0) 100%);"
    >
    </div>
    <header class="relative mb-16 border-b border-frost/10 pb-10">
      <p class="eyebrow mb-6">{t["blog.eyebrow"]}</p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.035em; line-height: 1.02;"
      >
        {t["blog.title"]}
      </h1>
      <p class="mt-8 text-dim max-w-[52ch] text-lg" style="line-height: 1.65;">
        {t["blog.intro"]}
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_290px] gap-14 items-start">
    <div>
      {posts.map((post) => (
        <article class="group border-b border-frost/10 py-12 first:pt-0">
          <p class="eyebrow text-muted mb-5">{fmt(post.data.pubDate)}</p>
          <h2
            class="font-display font-bold text-ink"
            style="font-size: clamp(22px, 2.6vw, 32px); letter-spacing: -0.02em; line-height: 1.2;"
          >
            <a href={`/padomi/${post.id}/`} class="hover:text-accent transition-colors">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-4 text-dim max-w-[62ch]" style="line-height: 1.65;">
            {post.data.description}
          </p>
          <div class="mt-8">
            <a
              href={`/padomi/${post.id}/`}
              class="eyebrow text-accent hover:text-ink transition-colors"
            >
              {t["blog.readmore"]} →
            </a>
          </div>
        </article>
      ))}
    </div>

    <SideRail
      eyebrow={t["tools.eyebrow"]}
      items={toolItems}
      moreHref={path("tools", locale)}
      moreLabel="Visi kalkulatori"
    />
    </div>
  </main>

  <Footer locale={locale} />
</Base>
