---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Hero from "~/components/Hero";
import LifestylePanel from "~/components/LifestylePanel";
import ProductReveal from "~/components/ProductReveal";
import FeatureGrid from "~/components/FeatureGrid";
import TrustPanel from "~/components/TrustPanel.astro";
import Faq from "~/components/Faq.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import Footer from "~/components/Footer.astro";

const locale = "en" as const;
---
<Base
  title="Taupi — know where your money goes."
  description="Taupi is a personal finance app: budgeting, receipt scanning, insights and goals in one place. Join the waitlist."
  locale={locale}
>
  <!-- Hero phone screenshot = desktop LCP. Preload it early on desktop;
       on mobile the phone is display:none and never gets fetched. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/screens/sakums.webp"
    media="(min-width: 768px)"
    fetchpriority="high"
  />
  <Nav locale={locale} />

  <main>
    <!-- Sticky-stacking intro on all viewports. -->
    <div class="relative h-[200vh]">
      <div class="w-full sticky top-0 h-screen overflow-hidden" style="z-index: 10;">
        <Hero locale={locale} client:load />
      </div>
      <div class="w-full sticky top-0 h-screen overflow-hidden" style="z-index: 20;">
        <LifestylePanel locale={locale} client:visible />
      </div>
    </div>

    <ProductReveal locale={locale} client:visible />

    <FeatureGrid locale={locale} client:visible />

    <TrustPanel locale={locale} />

    <Faq locale={locale} />

    <DownloadCTA locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
