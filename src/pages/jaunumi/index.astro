---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import SideRail from "~/components/SideRail.astro";
import { getCollection, render } from "astro:content";

/**
 * Jaunumi — /jaunumi/. Viena lapa ar visiem produkta atjauninājumiem
 * jaunākie-augšā; ieraksti ir īsi (changelog cilvēku valodā), tāpēc
 * atsevišķu lapu uz ierakstu nav — viss ķermenis renderējas šeit.
 * Lietotne uz šo lapu linkē no Iestatījumiem.
 */
const locale = "lv" as const;

const entries = (
  await getCollection("jaunumi", ({ data }) => !data.draft && data.locale === "lv")
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("lv-LV", { year: "numeric", month: "long", day: "numeric" });

// Tēmas filtra čipiem — atslēgas sakrīt ar content.config.ts `tema` enum.
const TEMAS = [
  { key: "budzets", label: "Budžets" },
  { key: "partika", label: "Pārtika" },
  { key: "izskats", label: "Izskats" },
] as const;
const temaLabel = Object.fromEntries(TEMAS.map((t) => [t.key, t.label]));
const temaCount = (key: string) => entries.filter((e) => e.data.tema === key).length;

// Enkurs bez datuma prefiksa: /jaunumi/#atra-izvele.
const anchor = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, "");

// Sānjosla: gida sākums — jaunumu lasītājs ir aktīvs lietotājs, un
// "kā šo lietot" ir dabiskais nākamais solis pēc "kas jauns".
const guideItems = (
  await getCollection("gids", ({ data }) => !data.draft && data.locale === "lv")
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
  .map((guide) => ({
    href: `/gids/${guide.id}/`,
    title: guide.data.title,
    desc: guide.data.description,
  }));
---
<Base
  title="Jaunumi — Taupi"
  description="Ko jaunu esam uzbūvējuši Taupi lietotnē: jaunās funkcijas, uzlabojumi un labojumi — īsi un cilvēku valodā."
  locale={locale}
  alternate={false}
  breadcrumbs={[{ name: "Jaunumi", href: "/jaunumi/" }]}
>
  <Nav locale={locale} />

  <main class="relative mx-auto max-w-content px-6 md:px-10 pt-36 md:pt-40 pb-24">
    {/* Kluss brand mirdzums aiz galvenes — kā padomi/gids lapās. */}
    <div
      aria-hidden
      class="pointer-events-none absolute -top-16 left-0 h-[480px] w-full max-w-[900px]"
      style="background: radial-gradient(closest-side, rgba(90,107,255,0.12) 0%, rgb(var(--bg-rgb) / 0) 100%);"
    >
    </div>
    <header class="relative mb-16 border-b border-frost/10 pb-10">
      <p class="eyebrow mb-6">Jaunumi</p>
      <h1
        class="font-display font-extrabold text-ink"
        style="font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.035em; line-height: 1.02;"
      >
        Ko jaunu esam uzbūvējuši
      </h1>
      <p class="mt-8 text-dim max-w-[52ch] text-lg" style="line-height: 1.65;">
        Taupi aug katru nedēļu — lielā daļa no šī saraksta ir lietotāju
        ieteikumi. Ja tev ir sava ideja, uzraksti mums no lietotnes
        atsauksmju sadaļas.
      </p>

      {/* Tēmu filtrs. Bez JS čipi nedara neko un redzami visi ieraksti;
          izvēle glabājas ?tema=, lai filtrētu skatu var iedot kā saiti. */}
      <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrēt pēc tēmas">
        <button type="button" class="tema-chip" data-tema-filter="" aria-pressed="true">
          Visi <span class="tema-count">{entries.length}</span>
        </button>
        {TEMAS.map((t) => (
          <button type="button" class="tema-chip" data-tema-filter={t.key} aria-pressed="false">
            {t.label} <span class="tema-count">{temaCount(t.key)}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_290px] gap-14 items-start">
    {/* -mt-12: pirmajam redzamajam ierakstam nav augšas atkāpes arī tad,
        ja filtrs paslēpis ierakstus virs tā (first:pt-0 to neredz). */}
    <div class="-mt-12">
      {rendered.map(({ entry, Content }) => (
        <article
          id={anchor(entry.id)}
          data-tema={entry.data.tema}
          class="border-b border-frost/10 py-12 scroll-mt-28"
        >
          <p class="eyebrow text-muted mb-5">
            {fmt(entry.data.pubDate)} · {temaLabel[entry.data.tema]}
          </p>
          <h2
            class="font-display font-bold text-ink"
            style="font-size: clamp(22px, 2.6vw, 32px); letter-spacing: -0.02em; line-height: 1.2;"
          >
            <a href={`#${anchor(entry.id)}`} class="hover:text-accent transition-colors">
              {entry.data.title}
            </a>
          </h2>
          <div class="prose-news mt-5 text-dim max-w-[62ch]" style="line-height: 1.7;">
            <Content />
          </div>
        </article>
      ))}
      <p data-tema-empty hidden class="py-12 text-dim">Šajā tēmā ierakstu vēl nav.</p>
    </div>

    {/* Sānjosla: ierakstu saturs (seko filtram) + gida sākums. Visa kolonna
        lipīga, tāpēc SideRail iekšējais sticky šeit neko nemaina. */}
    <div class="lg:sticky lg:top-28 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto space-y-10">
      <nav aria-label="Šajā lapā" class="hidden lg:block">
        <p class="eyebrow mb-1">Šajā lapā</p>
        <div class="divide-y divide-frost/[0.07]">
          {entries.map((entry) => (
            <a
              href={`#${anchor(entry.id)}`}
              data-tema={entry.data.tema}
              class="group block py-3"
            >
              <p class="eyebrow text-muted mb-1" style="font-size: 9.5px;">
                {fmt(entry.data.pubDate)}
              </p>
              <p
                class="font-display font-semibold text-ink/90 text-[14px] group-hover:text-accent transition-colors"
                style="letter-spacing: -0.01em; line-height: 1.35;"
              >
                {entry.data.title}
              </p>
            </a>
          ))}
        </div>
      </nav>

      <SideRail
        eyebrow="Gids"
        items={guideItems}
        moreHref="/gids/"
        moreLabel="Viss gids"
      />
    </div>
    </div>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  /* Markdown ķermenis manto lapas toņus; treknraksts paceļas uz ink. */
  .prose-news :global(p) {
    margin-top: 0.9em;
  }
  .prose-news :global(p:first-child) {
    margin-top: 0;
  }
  .prose-news :global(strong) {
    /* Bija var(--color-ink, #fff) — tokens neeksistē, un #fff gaišajā tēmā
       padarīja izcelto tekstu neredzamu. */
    color: var(--ink);
    font-weight: 600;
  }

  /* Klusi čipi: plāna mala, akcents tikai aktīvajam. */
  .tema-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--frost-rgb) / 0.15);
    color: rgb(var(--dim-rgb));
    font-size: 14px;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .tema-chip:hover {
    border-color: rgb(var(--frost-rgb) / 0.3);
    color: rgb(var(--ink-rgb));
  }
  .tema-chip[aria-pressed="true"] {
    border-color: rgb(var(--accent-rgb) / 0.55);
    background: rgb(var(--accent-rgb) / 0.07);
    color: rgb(var(--accent-rgb));
  }
  .tema-count {
    font-size: 12px;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  [data-tema][hidden] {
    display: none;
  }
</style>

<script>
  // Tēmu filtrs: slēpj ierakstus un sānjoslas saites, kuru tēma neatbilst;
  // izvēle dzīvo ?tema= (replaceState, bez vēstures trokšņa).
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-tema-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-tema]");
  const empty = document.querySelector<HTMLElement>("[data-tema-empty]");
  const valid = new Set(Array.from(chips, (c) => c.dataset.temaFilter ?? ""));

  function apply(tema: string) {
    chips.forEach((c) => c.setAttribute("aria-pressed", String((c.dataset.temaFilter ?? "") === tema)));
    let shown = 0;
    items.forEach((el) => {
      const hide = tema !== "" && el.dataset.tema !== tema;
      el.hidden = hide;
      if (!hide && el.tagName === "ARTICLE") shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }

  const initial = new URLSearchParams(location.search).get("tema") ?? "";
  // Ja atvērts ar #enkuru uz ierakstu no citas tēmas, filtrs nedrīkst to paslēpt.
  const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
  const start = valid.has(initial) && (!target || target.dataset.tema === initial || initial === "") ? initial : "";
  apply(start);

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const tema = chip.dataset.temaFilter ?? "";
      apply(tema);
      const url = new URL(location.href);
      if (tema) url.searchParams.set("tema", tema);
      else url.searchParams.delete("tema");
      url.hash = "";
      history.replaceState(null, "", url);
    }),
  );
</script>
