---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);

/**
 * Privātuma solījums — kompakta josla TIEŠI virs DownloadCTA, tajā pašā
 * brand krāsā (2026-09-18).
 *
 * Agrāk šī bija pilna ekrāna sekcija ar 120px virsrakstu un spec-lapas
 * rindām, un tā vilka uzmanību no produkta. Tagad tā ir viens solījums pirms
 * aicinājuma lejupielādēt: fons ir vienlaidu `brand` — tieši tā krāsa, ar ko
 * SĀKAS DownloadCTA gradients, tāpēc šuve starp abām sekcijām ir neredzama
 * un tās lasās kā viens krāsains bloks ar diviem taktiem.
 */
const principles = [
  { title: t["trust.p1.title"], detail: t["trust.p1.detail"] },
  { title: t["trust.p2.title"], detail: t["trust.p2.detail"] },
  { title: t["trust.p3.title"], detail: t["trust.p3.detail"] },
  { title: t["trust.p4.title"], detail: t["trust.p4.detail"] },
];
---
<section
  id="privacy"
  class="trust-rules relative pt-16 md:pt-24 pb-14 md:pb-16 px-4 md:px-10"
  style="background: rgb(var(--brand-rgb));"
>
  <div class="mx-auto max-w-content">
    <!-- Eyebrow ar hairline — tas pats ritms, kas pārējām sekcijām -->
    <div class="flex items-baseline gap-6 mb-10 md:mb-12">
      <span class="eyebrow" style="color: rgba(255,255,255,0.6);">{t["trust.eyebrow"]}</span>
      <span class="h-px flex-1" style="background: rgba(255,255,255,0.2);"></span>
    </div>

    <!-- Virsraksts un solījums blakus, nevis viens zem otra: uz pusi zemāks
         bloks un rinda paliek lasāma (58ch). -->
    <div class="grid grid-cols-1 md:grid-cols-[auto_minmax(0,1fr)] gap-6 md:gap-16 md:items-baseline">
      <h2
        class="font-display font-extrabold whitespace-nowrap"
        style="font-size: clamp(30px, 3.6vw, 52px); letter-spacing: -0.04em; line-height: 1; color: #fff;"
      >
        {t["trust.title.l1"]} {t["trust.title.l2"]}
      </h2>
      <p
        class="max-w-[58ch]"
        style="font-size: clamp(15px, 1.15vw, 18px); line-height: 1.55; color: rgba(255,255,255,0.8);"
      >
        {t["trust.body"]}
      </p>
    </div>

    <!-- Četri fakti rindā, nevis četras pilna platuma rindas -->
    <ul
      class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7 list-none"
      style="border-top: 1px solid rgba(255,255,255,0.22); padding-top: 2rem;"
    >
      {principles.map((p, i) => (
        <li>
          <span
            class="eyebrow block mb-2"
            style="font-variant-numeric: tabular-nums; color: rgba(255,255,255,0.45);"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <span
            class="block"
            style="font-family: 'DM Sans', system-ui, sans-serif; font-weight: 500; font-size: 15px; letter-spacing: -0.01em; line-height: 1.35; color: #fff;"
          >
            {p.title}
          </span>
          {p.detail !== "—" && (
            <span
              class="block mt-1.5"
              style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.1em; color: rgba(255,255,255,0.6);"
            >
              {p.detail}
            </span>
          )}
        </li>
      ))}
    </ul>

    <p class="mt-10 md:mt-12 eyebrow" style="color: rgba(255,255,255,0.5);">
      {t["trust.signature"]}
    </p>
  </div>
</section>
