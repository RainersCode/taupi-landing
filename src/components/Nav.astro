---
import { launch } from "~/config";
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";
import { path } from "~/i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const altHref = locale === "lv" ? "/en/" : "/";
const altLabel = locale === "lv" ? "EN" : "LV";
// Anchors are home-absolute so the nav also works from blog/legal pages.
const home = path("home", locale);
const toolsHref = path("tools", locale);
const aboutHref = path("about", locale);
---
<!-- Mobile: tight (px-4, py-3, hide Download button — CTA is below the fold).
     Desktop: unchanged (px-10, py-5). Removed backdrop-blur to avoid scroll
     compositor jank during the pinned reveal section. -->
<header class="fixed top-0 left-0 right-0 z-50 px-4 md:px-10 py-3 md:py-5" style="background: rgb(var(--bg-rgb) / 0.72);">
  <div class="mx-auto max-w-content flex items-center justify-between">
    <!-- Gredzens mark + wordmark -->
    <a href={locale === "lv" ? "/" : "/en/"} class="group flex items-center gap-2.5">
      <img src="/gredzens.svg" alt="" width="26" height="26" />
      <span class="font-display font-extrabold text-xl md:text-2xl text-ink" style="letter-spacing: -0.04em;">
        taupi<span class="text-accent">.</span>
      </span>
    </a>

    <!-- Right cluster -->
    <nav class="flex items-center gap-4 md:gap-10">
      <a href={`${home}#features`} class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]">
        {t["nav.features"]}
      </a>
      <a href={`${home}#privacy`} class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]">
        {t["nav.privacy"]}
      </a>
      {locale === "lv" && (
        <a href="/jaunumi/" class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]">
          Jaunumi
        </a>
        <a href="/padomi/" class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]">
          {t["nav.blog"]}
        </a>
      )}
      {locale === "lv" && (
        <a href="/gids/" class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]">
          {t["nav.gids"]}
        </a>
      )}
      <a
        href={toolsHref}
        class="hidden md:inline nav-link rounded-full px-3 py-2 hover:bg-frost/[0.06]"
      >
        {t["nav.tools"]}
      </a>
      <a
        href={altHref}
        class="nav-link text-ink/60 hover:text-accent"
        aria-label={`Switch to ${altLabel}`}
      >
        {altLabel}
      </a>
      <!-- Tēmas slēdzis: rāda PRETĒJO tēmu (saule tumšajā → klikšķis uz gaišo). -->
      <button
        id="theme-toggle"
        type="button"
        class="flex items-center justify-center w-9 h-9 rounded-full border border-frost/15 text-dim hover:text-ink hover:border-frost/25 transition-colors"
        aria-label={locale === "lv" ? "Pārslēgt gaišo/tumšo tēmu" : "Toggle light/dark theme"}
      >
        <svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M4.8 4.8l1.6 1.6M17.6 17.6l1.6 1.6M19.2 4.8l-1.6 1.6M6.4 17.6l-1.6 1.6" />
        </svg>
        <svg class="theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
        </svg>
      </button>
      <a
        href={`${home}#waitlist`}
        class="hidden md:inline-flex items-center rounded-full bg-brand px-5 py-2.5 text-sm font-medium hover:bg-brand-deep transition-colors" style="color: #fff;"
      >
        {launch.live ? t["nav.download"] : t["nav.join"]}
      </a>

      <!-- Mobile menu — native <details> toggle opening a full-screen
           panel with display-scale links (the site's own type language),
           staggered rise-in and a soft brand glow. No JS island; a tiny
           inline script closes it after a tap and locks page scroll. -->
      <details id="mobile-nav" class="md:hidden">
        <summary
          class="list-none cursor-pointer flex items-center justify-center w-10 h-10 -mr-1.5 text-ink"
          aria-label={locale === "lv" ? "Izvēlne" : "Menu"}
        >
          <svg class="nav-burger" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg class="nav-close" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>

        <div class="nav-panel">
          <nav class="panel-inner">
            <div class="panel-links">
              <a href={`${home}#features`}>{t["nav.features"]}</a>
              <a href={`${home}#privacy`}>{t["nav.privacy"]}</a>
              <a href={toolsHref}>
                {t["nav.tools"]}
              </a>
              {locale === "lv" && <a href="/padomi/">{t["nav.blog"]}</a>}
              {locale === "lv" && <a href="/jaunumi/">Jaunumi</a>}
              {locale === "lv" && <a href="/gids/">{t["nav.gids"]}</a>}
              <a href={aboutHref}>
                {t["footer.legal.about"]}
              </a>
            </div>

            <div class="panel-bottom">
              <a href={`${home}#waitlist`} class="panel-cta">{launch.live ? t["nav.download"] : t["nav.join"]}</a>
              <div class="panel-contact">
                <a href="mailto:info@taupi.eu">info@taupi.eu</a>
                <a href="tel:+37128333522">+371 28 333 522</a>
              </div>
              <p class="panel-made">
                <span>{t["footer.made"]}</span>
                <span>taupi.eu</span>
              </p>
            </div>
          </nav>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* Tēmas slēdža ikonas: saule tumšajā (aicina uz gaišo), mēness gaišajā. */
  .theme-moon {
    display: none;
  }
  :global([data-theme="light"]) .theme-sun {
    display: none;
  }
  :global([data-theme="light"]) .theme-moon {
    display: block;
  }

  /* Hide the default disclosure triangle across browsers */
  #mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  #mobile-nav .nav-close {
    display: none;
  }
  #mobile-nav[open] .nav-burger {
    display: none;
  }
  #mobile-nav[open] .nav-close {
    display: block;
  }

  /* Full-screen panel. Sits on z:-1 inside the fixed header's stacking
     context: above the page, below the header row — logo, EN switch and
     the ✕ stay visible and tappable while the menu is open. */
  #mobile-nav .nav-panel {
    display: none;
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 40% at 85% 8%, rgb(var(--brand-rgb) / 0.16), transparent 65%),
      radial-gradient(45% 35% at 8% 96%, rgb(var(--accent-rgb) / 0.08), transparent 65%),
      var(--bg);
  }
  #mobile-nav[open] .nav-panel {
    display: flex;
    overflow-y: auto;
    animation: panel-fade 0.3s ease both;
  }

  .panel-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 104px 24px calc(24px + env(safe-area-inset-bottom));
  }

  .panel-links {
    display: flex;
    flex-direction: column;
  }
  .panel-links a {
    font-family: var(--font-display);
    /* 800/40px lasījās kā kliegšana pilnekrāna panelī — 600 un mazliet
       mazāks izmērs tur pašu hierarhiju, bet bez plakāta smaguma. */
    font-weight: 600;
    font-size: clamp(24px, 6.5vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
    padding: 16px 0;
    border-bottom: 1px solid rgb(var(--frost-rgb) / 0.06);
  }
  .panel-links a:active {
    color: var(--accent);
  }

  .panel-bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .panel-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    border-radius: 9999px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
  }
  .panel-cta:active {
    background: var(--accent);
  }
  .panel-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .panel-contact a {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--dim);
    text-decoration: none;
  }
  .panel-contact a:active {
    color: var(--accent);
  }
  .panel-made {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  /* Staggered rise-in for links + bottom group */
  #mobile-nav[open] .panel-links a,
  #mobile-nav[open] .panel-bottom > * {
    animation: panel-rise 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  #mobile-nav[open] .panel-links a:nth-child(1) { animation-delay: 0.05s; }
  #mobile-nav[open] .panel-links a:nth-child(2) { animation-delay: 0.11s; }
  #mobile-nav[open] .panel-links a:nth-child(3) { animation-delay: 0.17s; }
  #mobile-nav[open] .panel-links a:nth-child(4) { animation-delay: 0.23s; }
  #mobile-nav[open] .panel-links a:nth-child(5) { animation-delay: 0.29s; }
  #mobile-nav[open] .panel-cta { animation-delay: 0.3s; }
  #mobile-nav[open] .panel-contact { animation-delay: 0.35s; }
  #mobile-nav[open] .panel-made { animation-delay: 0.4s; }

  @keyframes panel-fade {
    from { opacity: 0; }
  }
  @keyframes panel-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav[open] .nav-panel,
    #mobile-nav[open] .panel-links a,
    #mobile-nav[open] .panel-bottom > * {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Close the menu after tapping a link (same-page anchors don't reload),
  // and lock page scroll behind the full-screen panel while it's open.
  (() => {
    const nav = document.getElementById("mobile-nav");
    if (!nav) return;
    nav.addEventListener("toggle", () => {
      document.documentElement.style.overflow = nav.open ? "hidden" : "";
    });
    nav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => nav.removeAttribute("open"));
    });
  })();

  // Tēmas slēdzis — pārslēdz data-theme uz <html>, iegaumē localStorage un
  // notur pārlūka chrome krāsu (theme-color) sinhronā ar lapu.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const light = root.dataset.theme !== "light";
    if (light) root.dataset.theme = "light";
    else delete root.dataset.theme;
    try { localStorage.setItem("theme", light ? "light" : "dark"); } catch {}
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", light ? "#F5F1FD" : "#0D1128");
  });
</script>
