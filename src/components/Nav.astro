---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const altHref = locale === "lv" ? "/en/" : "/";
const altLabel = locale === "lv" ? "EN" : "LV";
// Anchors are home-absolute so the nav also works from blog/legal pages.
const home = locale === "lv" ? "/" : "/en/";
---
<!-- Mobile: tight (px-4, py-3, hide Download button — CTA is below the fold).
     Desktop: unchanged (px-10, py-5). Removed backdrop-blur to avoid scroll
     compositor jank during the pinned reveal section. -->
<header class="fixed top-0 left-0 right-0 z-50 px-4 md:px-10 py-3 md:py-5" style="background: rgba(13, 17, 40, 0.72);">
  <div class="mx-auto max-w-content flex items-center justify-between">
    <!-- Gredzens mark + wordmark -->
    <a href={locale === "lv" ? "/" : "/en/"} class="group flex items-center gap-2.5">
      <img src="/gredzens.svg" alt="" width="26" height="26" />
      <span class="font-display font-extrabold text-xl md:text-2xl text-ink" style="letter-spacing: -0.04em;">
        taupi<span class="text-accent">.</span>
      </span>
    </a>

    <!-- Right cluster -->
    <nav class="flex items-center gap-4 md:gap-10">
      <a href={`${home}#features`} class="hidden md:inline eyebrow hover:text-ink transition-colors">
        {t["nav.features"]}
      </a>
      <a href={`${home}#privacy`} class="hidden md:inline eyebrow hover:text-ink transition-colors">
        {t["nav.privacy"]}
      </a>
      {locale === "lv" && (
        <a href="/padomi/" class="hidden md:inline eyebrow hover:text-ink transition-colors">
          {t["nav.blog"]}
        </a>
      )}
      <a
        href={altHref}
        class="eyebrow text-ink/60 hover:text-accent transition-colors"
        aria-label={`Switch to ${altLabel}`}
      >
        {altLabel}
      </a>
      <a
        href={`${home}#waitlist`}
        class="hidden md:inline-flex items-center rounded-full bg-ink text-bg px-5 py-2.5 text-sm font-medium hover:bg-accent hover:text-bg transition-colors"
      >
        {t["nav.join"]}
      </a>

      <!-- Mobile menu — native <details> dropdown (no JS island, matching
           the FAQ's approach); an inline one-liner closes it after a tap. -->
      <details id="mobile-nav" class="md:hidden relative">
        <summary
          class="list-none cursor-pointer flex items-center justify-center w-10 h-10 -mr-1.5 text-ink"
          aria-label={locale === "lv" ? "Izvēlne" : "Menu"}
        >
          <svg class="nav-burger" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg class="nav-close" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>

        <div
          class="absolute right-0 mt-3 w-60 rounded-2xl border border-white/10 py-2 divide-y divide-white/5"
          style="background: rgba(13, 17, 40, 0.97); box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);"
        >
          <a href={`${home}#features`} class="block px-5 py-3.5 eyebrow hover:text-ink transition-colors">
            {t["nav.features"]}
          </a>
          <a href={`${home}#privacy`} class="block px-5 py-3.5 eyebrow hover:text-ink transition-colors">
            {t["nav.privacy"]}
          </a>
          {locale === "lv" && (
            <a href="/padomi/" class="block px-5 py-3.5 eyebrow hover:text-ink transition-colors">
              {t["nav.blog"]}
            </a>
          )}
          <a
            href={`${home}#waitlist`}
            class="block px-5 py-3.5 eyebrow transition-colors"
            style="color: #38BDF8;"
          >
            {t["nav.join"]}
          </a>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* Hide the default disclosure triangle across browsers */
  #mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  #mobile-nav .nav-close {
    display: none;
  }
  #mobile-nav[open] .nav-burger {
    display: none;
  }
  #mobile-nav[open] .nav-close {
    display: block;
  }
</style>

<script is:inline>
  // Close the mobile menu after tapping a link — same-page anchor taps
  // don't reload the page, so the panel would otherwise stay open.
  document.querySelectorAll("#mobile-nav a").forEach((a) => {
    a.addEventListener("click", () => document.getElementById("mobile-nav").removeAttribute("open"));
  });
</script>
