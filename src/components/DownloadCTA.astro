---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);

// NOTE: Official Apple / Google store badges have strict branding guidelines.
// For v1 we use generic-but-tasteful black pill buttons that read as "store
// download" without infringing. Swap for official SVG assets (from Apple
// marketing toolbox / Google Play branding) before public launch.
---
<section id="download" class="relative py-24 md:py-48 px-4 md:px-10 border-t border-white/5 overflow-hidden">
  <!-- Subtle backdrop halo behind the CTA -->
  <div
    aria-hidden
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(50% 45% at 50% 45%, rgba(90, 107, 255, 0.14), transparent 60%);"
  />

  <!-- Mobile decorative — positioned below the buttons so it sits at the
       bottom of the section instead of right behind the headline. -->
  <div
    aria-hidden
    class="md:hidden pointer-events-none absolute left-1/2 bottom-8 -translate-x-1/2 font-display font-black select-none whitespace-nowrap"
    style="font-size: clamp(96px, 24vw, 180px); line-height: 0.85; color: rgba(255,255,255,0.04); letter-spacing: -0.06em;"
  >
    taupi<span style="color: rgba(79, 209, 255, 0.08)">.</span>
  </div>

  <!-- Desktop decorative — gigantic signature wordmark behind the CTA -->
  <div
    aria-hidden
    class="hidden md:block pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-display font-black select-none whitespace-nowrap"
    style="font-size: clamp(240px, 36vw, 560px); line-height: 0.85; color: rgba(255,255,255,0.02); letter-spacing: -0.06em;"
  >
    taupi<span style="color: rgba(79, 209, 255, 0.06)">.</span>
  </div>

  <div class="mx-auto max-w-content relative text-center">
    <h2
      class="font-display font-extrabold text-ink mx-auto"
      style="font-size: clamp(48px, 9vw, 128px); letter-spacing: -0.05em; line-height: 0.95; max-width: 12ch;"
    >
      {t["cta.title"]}
    </h2>

    <p
      class="mt-8 text-dim mx-auto"
      style="font-size: clamp(16px, 1.4vw, 20px); line-height: 1.5; max-width: 48ch;"
    >
      {t["cta.sub"]}
    </p>

    <!-- Store buttons — frosted glass, content centered as a unit. -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <!-- App Store -->
      <a
        href="#"
        class="store-btn group"
        aria-label={t["cta.ios"]}
      >
        <span class="store-btn__inner">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="store-btn__icon">
            <path d="M17.5 12.6c0-2.2 1.8-3.3 1.9-3.3-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.9-.8-1.5 0-2.8.9-3.6 2.2-1.5 2.7-.4 6.7 1.1 8.9.7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.7.7 2.9.7c1.2 0 1.9-1.1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.5 0 0-2.3-.9-2.3-3.7zM15.4 6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2z"/>
          </svg>
          <span class="store-btn__text">
            <span class="store-btn__eyebrow">
              {locale === "lv" ? "Lejupielādēt no" : "Download on the"}
            </span>
            <span class="store-btn__title">App Store</span>
          </span>
        </span>
      </a>

      <!-- Google Play -->
      <a
        href="#"
        class="store-btn group"
        aria-label={t["cta.android"]}
      >
        <span class="store-btn__inner">
          <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" class="store-btn__icon">
            <defs>
              <linearGradient id="gpA" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#00D4FF"/><stop offset="1" stop-color="#0070FF"/>
              </linearGradient>
              <linearGradient id="gpB" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#00FFA3"/><stop offset="1" stop-color="#00C853"/>
              </linearGradient>
              <linearGradient id="gpC" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#FFEE00"/><stop offset="1" stop-color="#FFC107"/>
              </linearGradient>
              <linearGradient id="gpD" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FF3A44"/><stop offset="1" stop-color="#C5005C"/>
              </linearGradient>
            </defs>
            <path d="M3.5 2.3v19.4c0 .5.2.9.5 1.2l10.8-10.9L4 1.1c-.3.3-.5.7-.5 1.2z" fill="url(#gpA)"/>
            <path d="M17.6 15.3L20.9 13.4c1.1-.6 1.1-2.1 0-2.8L17.6 8.7l-3.2 3.3 3.2 3.3z" fill="url(#gpC)"/>
            <path d="M4 1.1l10.4 10.9 3.2-3.3L5.5.4C5-.1 4.3 0 4 .4" fill="url(#gpB)"/>
            <path d="M4 22.9c.4.4 1 .5 1.5.2l12.1-6.9L14.4 13 4 22.9z" fill="url(#gpD)"/>
          </svg>
          <span class="store-btn__text">
            <span class="store-btn__eyebrow">
              {locale === "lv" ? "Pieejams" : "Get it on"}
            </span>
            <span class="store-btn__title">Google Play</span>
          </span>
        </span>
      </a>
    </div>

    <!-- QR placeholder row — tasteful "scan on mobile" affordance -->
    <p class="mt-16 eyebrow text-muted">
      taupi.eu
    </p>
  </div>
</section>

<style>
  .store-btn {
    --glass-bg: rgba(255, 255, 255, 0.045);
    --glass-bg-hover: rgba(255, 255, 255, 0.085);
    --glass-border: rgba(255, 255, 255, 0.10);
    --glass-border-hover: rgba(255, 255, 255, 0.22);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 64px;
    padding: 0 22px;
    border-radius: 16px;
    color: var(--ink);
    text-decoration: none;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 10px 28px -16px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    transition:
      transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 240ms ease,
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  /* Top-edge highlight ribbon — gives the glass a subtle light-catch */
  .store-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0) 38%
    );
  }

  .store-btn:hover {
    background: var(--glass-bg-hover);
    border-color: var(--glass-border-hover);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 18px 38px -18px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(79, 209, 255, 0.08);
  }

  .store-btn:focus-visible {
    outline: none;
    border-color: rgba(79, 209, 255, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 0 3px rgba(79, 209, 255, 0.18);
  }

  .store-btn__inner {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .store-btn__icon {
    flex-shrink: 0;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .store-btn:hover .store-btn__icon {
    transform: scale(1.06);
  }

  .store-btn__text {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    line-height: 1;
  }

  .store-btn__eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.58);
    line-height: 1;
  }

  .store-btn__title {
    margin-top: 5px;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1;
    color: var(--ink);
  }

  /* Reduce blur cost on devices that don't support it cleanly */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .store-btn {
      background: rgba(255, 255, 255, 0.07);
    }
  }
</style>
