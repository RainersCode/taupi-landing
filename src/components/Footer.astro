---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";
import { socials } from "~/config";
import WaitlistForm from "~/components/WaitlistForm";

interface Props {
  locale: Locale;
  /** Hide the newsletter band on pages that already end in the big
      #waitlist section (the home pages) — two adjacent forms look broken. */
  newsletter?: boolean;
}
const { locale, newsletter = true } = Astro.props;
const t = getDict(locale);
const privacyHref = locale === "en" ? "/en/privacy-policy/" : "/privacy-policy/";
const termsHref = locale === "en" ? "/en/terms-of-service/" : "/terms-of-service/";
const aboutHref = locale === "en" ? "/en/par-taupi/" : "/par-taupi/";

const pages = [
  { href: aboutHref, label: t["footer.legal.about"] },
  ...(locale === "lv" ? [{ href: "/padomi/", label: t["blog.eyebrow"] }] : []),
  { href: privacyHref, label: t["footer.legal.privacy"] },
  { href: termsHref, label: t["footer.legal.terms"] },
];

