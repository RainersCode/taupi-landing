---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const privacyHref = locale === "en" ? "/en/privacy-policy/" : "/privacy-policy/";
const termsHref = locale === "en" ? "/en/terms-of-service/" : "/terms-of-service/";
---
<footer class="relative py-14 md:py-20 px-4 md:px-10 border-t border-white/5">
  <div class="mx-auto max-w-content flex flex-col md:flex-row md:items-end md:justify-between gap-10">
    <div>
      <span class="flex items-center gap-3">
        <img src="/gredzens.svg" alt="" width="40" height="40" />
        <span class="font-display font-extrabold text-5xl text-ink" style="letter-spacing: -0.04em;">
          taupi<span class="text-accent">.</span>
        </span>
      </span>
      <p class="mt-3 eyebrow text-muted">{t["footer.made"]}</p>
    </div>

    <ul class="flex flex-wrap gap-x-8 gap-y-3">
      <li>
        <a href={privacyHref} class="eyebrow hover:text-ink transition-colors">
          {t["footer.legal.privacy"]}
        </a>
      </li>
      <li>
        <a href={termsHref} class="eyebrow hover:text-ink transition-colors">
          {t["footer.legal.terms"]}
        </a>
      </li>
      <li>
        <a href="mailto:info@taupi.eu" class="eyebrow hover:text-ink transition-colors">
          {t["footer.legal.support"]}
        </a>
      </li>
    </ul>
  </div>

  <div class="mx-auto max-w-content mt-16 pt-6 border-t border-white/5 flex items-center justify-between text-xs">
    <span class="eyebrow text-muted">© {new Date().getFullYear()} taupi</span>
    <span class="eyebrow text-muted">taupi.eu</span>
  </div>
</footer>
