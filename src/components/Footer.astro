---
<footer class="relative py-14 md:py-20 px-4 md:px-10 border-t border-white/5">
  {newsletter && (
    <div
      class="mx-auto max-w-content mb-14 md:mb-16 pb-12 md:pb-16 border-b border-white/5 grid grid-cols-1 md:grid-cols-12 gap-8 md:items-center"
    >
      <div class="md:col-span-6">
        <p class="eyebrow mb-5">{t["footer.news"]}</p>
        <p
          class="font-display font-bold text-ink"
          style="font-size: clamp(24px, 2.6vw, 34px); letter-spacing: -0.025em; line-height: 1.15; max-width: 18ch;"
        >
          {t["footer.news.title"]}
        </p>
      </div>
      <div class="md:col-span-6 w-full md:max-w-[440px] md:justify-self-end">
        <WaitlistForm client:visible locale={locale} />
      </div>
    </div>
  )}

  <div class="mx-auto max-w-content grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
    <!-- Brand + socials -->
    <div class="md:col-span-6">
      <span class="flex items-center gap-3">
        <img src="/gredzens.svg" alt="" width="40" height="40" />
        <span class="font-display font-extrabold text-5xl text-ink" style="letter-spacing: -0.04em;">
          taupi<span class="text-accent">.</span>
        </span>
      </span>
      <p class="mt-3 eyebrow text-muted">{t["footer.made"]}</p>

      <!-- Social profiles — icon set mirrors `socials` in src/config.ts -->
      <div class="mt-6 flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            title={s.label}
            class="flex items-center justify-center w-9 h-9 rounded-full border border-white/10 text-dim hover:text-accent hover:border-accent/40 transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={iconPaths[s.label]} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Pages -->
    <nav class="md:col-span-3" aria-label={t["footer.pages"]}>
      <p class="eyebrow text-muted mb-6">{t["footer.pages"]}</p>
      <ul class="space-y-4">
        {pages.map((p) => (
          <li>
            <a href={p.href} class="eyebrow hover:text-ink transition-colors">
              {p.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Contact -->
    <div class="md:col-span-3">
      <p class="eyebrow text-muted mb-6">{t["footer.contact"]}</p>
      <ul class="space-y-4 font-mono text-[13px]" style="letter-spacing: 0.04em;">
        <li>
          <a href="mailto:info@taupi.eu" class="text-dim hover:text-ink transition-colors">
            info@taupi.eu
          </a>
        </li>
        <li>
          <a href="tel:+37128333522" class="text-dim hover:text-ink transition-colors">
            +371 28 333 522
          </a>
        </li>
        <li class="text-muted">{t["footer.location"]}</li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-content mt-16 pt-6 border-t border-white/5 flex items-center justify-between text-xs">
    <span class="eyebrow text-muted">© {new Date().getFullYear()} taupi</span>
    <span class="eyebrow text-muted">taupi.eu</span>
  </div>
</footer>
