---
import type { Locale } from "~/i18n/strings";
import { getDict } from "~/i18n/strings";

/**
 * FAQ — pre-launch questions + the tester offer, and the site's main body
 * of indexable text for Google. Static HTML with native <details> accordions
 * (no JS island), plus FAQPage JSON-LD for rich results.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const items = [1, 2, 3, 4, 5].map((n) => ({
  q: t[`faq.q${n}`],
  a: t[`faq.a${n}`],
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a },
  })),
};
---
<section id="faq" class="relative py-24 md:py-40 px-4 md:px-10 border-t border-white/5">
  <div class="mx-auto max-w-content">
    <div class="flex items-baseline gap-6 mb-12 md:mb-16">
      <span class="eyebrow">{t["faq.eyebrow"]}</span>
      <span class="h-px flex-1 bg-white/10"></span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <h2
        class="md:col-span-5 font-display font-extrabold text-ink"
        style="font-size: clamp(34px, 4.4vw, 64px); letter-spacing: -0.035em; line-height: 1.02;"
      >
        {t["faq.title"]}
      </h2>

      <div class="md:col-span-7">
        {items.map((it) => (
          <details class="faq-item group border-b border-white/10">
            <summary class="flex items-center justify-between gap-6 cursor-pointer list-none py-6 md:py-7">
              <span
                class="font-display font-semibold text-ink"
                style="font-size: clamp(17px, 1.6vw, 21px); letter-spacing: -0.015em; line-height: 1.35;"
              >
                {it.q}
              </span>
              <svg
                class="faq-chevron shrink-0"
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 7l5 5 5-5"
                  stroke="#38BDF8"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <p class="pb-7 text-dim max-w-[62ch]" style="font-size: 15.5px; line-height: 1.65;">
              {it.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<style>
  /* Hide the default disclosure triangle across browsers */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
