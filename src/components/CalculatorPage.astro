---
/**
 * Shared body for the budget calculator — /budzeta-kalkulators/ (lv) and
 * /en/budget-calculator/. Paths per locale come from ~/i18n/routes.
 */
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import ToolFaq from "~/components/ToolFaq.astro";
import BudgetCalculator, { LINE_COLORS } from "~/components/calculator/BudgetCalculator";
import { getCollection, render } from "astro:content";
import { toolFaqs } from "~/i18n/toolFaqs";
import { getDict } from "~/i18n/strings";
import type { Locale } from "~/i18n/strings";
import { path } from "~/i18n/routes";
import { BENCHMARKS, LINES } from "~/lib/affordability";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** ISO date the benchmarks and copy were last checked — see ToolPage. */
  reviewed?: string;
}
const { locale, title, description, reviewed } = Astro.props;
const t = getDict(locale);

// Long-form body for this tool in this locale, if written
// (src/content/tools/budget-<locale>.md) — same mechanism as ToolPage.
const deep = (await getCollection("tools", ({ data }) => data.tool === "budget" && data.locale === locale))[0];
const Deep = deep ? (await render(deep)).Content : undefined;

const breadcrumbs = [
  { name: t["tools.title"], href: path("tools", locale) },
  { name: t["bc.title"], href: path("budget", locale) },
];

const reviewedLabel = reviewed
  ? new Date(reviewed).toLocaleDateString(locale === "lv" ? "lv-LV" : "en-GB", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : undefined;

const schema = reviewed
  ? [
      {
        "@type": "WebPage",
        "@id": new URL(Astro.url.pathname, Astro.site ?? "https://taupi.eu").href,
        name: t["bc.title"],
        description,
        inLanguage: locale,
        dateModified: reviewed,
      },
    ]
  : [];

// Tip-article cards beside the method section — internal links between the
// tool and the blog. The blog is lv-only, so the EN page renders the method
// section alone; new posts appear here automatically.
const posts =
  locale === "lv"
    ? (await getCollection("blog", ({ data }) => !data.draft && data.locale === "lv"))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 3)
    : [];

const fmtDate = (d: Date) =>
  d.toLocaleDateString("lv-LV", { year: "numeric", month: "long", day: "numeric" });

// Benchmark table rows — straight from the logic file so the SEO text can
// never drift from what the tool actually scores.
const share = (n: number, min: boolean) =>
  (min ? t["bc.table.min"] : t["bc.table.max"]).replace("{n}", String(n));

const rows = LINES.map((k) => {
  const b = BENCHMARKS[k];
  return {
    color: LINE_COLORS[k],
    label: t[`bc.line.${k}`],
    rec: share(b.good, b.higherBetter),
    ok: share(b.amber, b.higherBetter),
  };
});

const legend = [
  { color: "#2DD4A7", label: t["bc.legend.good"] },
  { color: "#FFB547", label: t["bc.legend.amber"] },
  { color: "#FF3B87", label: t["bc.legend.bad"] },
];
---
<Base
  title={title}
  description={description}
  locale={locale}
  ogImage={`/og/budget${locale === "en" ? "-en" : ""}.jpg`}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <Nav locale={locale} />

  <main class="pt-32 md:pt-40 pb-8">
    <!-- ── Page header ── -->
    <header class="mx-auto max-w-6xl px-6 md:px-10 mb-10 md:mb-14">
      <p class="eyebrow mb-6">
        <a href={path("tools", locale)} class="hover:text-ink transition-colors">
          ← {t["tools.back"]}
        </a>
      </p>
      <h1 class="display-xl text-ink">{t["bc.title"]}</h1>
      <p class="mt-6 text-dim max-w-[56ch] text-lg" style="line-height: 1.65;">
        {t["bc.sub"]}
      </p>
    </header>

    <!-- ── The tool ── -->
    <section class="mx-auto max-w-6xl px-6 md:px-10">
      <BudgetCalculator client:load locale={locale} />
    </section>

    <!-- ── Method + benchmarks (the SEO substance), with tip-article cards
         beside it on lv (the blog is lv-only). ── -->
    <section class={`mx-auto px-6 md:px-10 mt-24 md:mt-32 ${posts.length ? "max-w-6xl" : "max-w-3xl"}`}>
      <div class={posts.length ? "grid grid-cols-1 lg:grid-cols-[1fr_330px] gap-14 lg:gap-16 items-start" : ""}>
      <div>
      <p class="eyebrow mb-5">{t["bc.method.eyebrow"]}</p>
      <h2
        class="font-display font-bold text-ink"
        style="font-size: clamp(24px, 3vw, 36px); letter-spacing: -0.02em; line-height: 1.2;"
      >
        {t["bc.method.title"]}
      </h2>
      <p class="mt-5 text-dim" style="line-height: 1.7;">{t["bc.method.body"]}</p>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {legend.map((l) => (
          <span class="flex items-center gap-2 text-[13px] text-dim">
            <span aria-hidden class="w-2.5 h-2.5 rounded-full" style={`background: ${l.color};`} />
            {l.label}
          </span>
        ))}
      </div>

      <table class="w-full mt-6 border-collapse text-[14px]">
        <thead>
          <tr>
            <th class="text-left font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 pr-3 border-b border-white/10">
              {t["bc.table.category"]}
            </th>
            <th class="text-right font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 px-3 border-b border-white/10">
              {t["bc.table.rec"]}
            </th>
            <th class="text-right font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 pl-3 border-b border-white/10">
              {t["bc.table.ok"]}
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="py-3 pr-3 border-b border-white/5 text-ink">
                <span class="flex items-center gap-2.5">
                  <span aria-hidden class="w-2.5 h-2.5 rounded-[4px] shrink-0" style={`background: ${r.color};`} />
                  {r.label}
                </span>
              </td>
              <td class="py-3 px-3 border-b border-white/5 text-right font-mono text-dim tabular-nums">{r.rec}</td>
              <td class="py-3 pl-3 border-b border-white/5 text-right font-mono text-muted tabular-nums">{r.ok}</td>
            </tr>
          ))}
        </tbody>
      </table>

      {Deep && (
        <div class="legal-prose mt-12">
          <Deep />
        </div>
      )}

      {deep && deep.data.sources.length > 0 && (
        <div class="mt-14 border-t border-white/10 pt-8">
          <p class="eyebrow mb-5">{t["blog.sources"]}</p>
          <ul class="space-y-3">
            {deep.data.sources.map((src) => (
              <li>
                <a
                  href={src.href}
                  target="_blank"
                  rel="noopener"
                  class="text-[14px] text-dim hover:text-accent transition-colors"
                  style="line-height: 1.6;"
                >
                  {src.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {reviewedLabel && (
        <p class="mt-10 eyebrow text-muted">{t["tools.reviewed"]} {reviewedLabel}</p>
      )}

      <!-- Bridge to the app: on web you type the numbers, in the app they come
           from your real spending. -->
      <p
        class="mt-10 px-5 py-4 rounded-xl text-[15px] text-ink"
        style="background: rgba(90, 107, 255, 0.08); border: 1px solid rgba(90, 107, 255, 0.25); line-height: 1.6;"
      >
        {t["bc.app.note"]}
      </p>
      </div>

      {posts.length > 0 && (
        <aside class="lg:sticky lg:top-28">
          <p class="eyebrow mb-5">{t["blog.eyebrow"]}</p>
          <div class="space-y-4">
            {posts.map((post) => (
              <a
                href={`/padomi/${post.id}/`}
                class="group block rounded-2xl p-5 bg-white/[0.04] border border-white/10 hover:border-accent/40 transition-colors"
              >
                <p class="eyebrow text-muted mb-3" style="font-size: 10px;">
                  {fmtDate(post.data.pubDate)}
                </p>
                <p
                  class="font-display font-bold text-ink text-[17px] group-hover:text-accent transition-colors"
                  style="letter-spacing: -0.01em; line-height: 1.3;"
                >
                  {post.data.title}
                </p>
                <p class="mt-2.5 text-[13px] text-dim line-clamp-3" style="line-height: 1.55;">
                  {post.data.description}
                </p>
                <p class="mt-3.5 eyebrow text-accent">{t["blog.readmore"]} →</p>
              </a>
            ))}
          </div>
          <a href="/padomi/" class="mt-6 inline-block eyebrow hover:text-ink transition-colors">
            {t["blog.back"]} →
          </a>
        </aside>
      )}
      </div>
    </section>

    <ToolFaq locale={locale} items={toolFaqs.budget[locale]} />
  </main>

  <DownloadCTA locale={locale} />
  <Footer locale={locale} />
</Base>
