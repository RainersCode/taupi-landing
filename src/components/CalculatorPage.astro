---
/**
 * Shared body for /budzeta-kalkulators/ (lv) and /en/budzeta-kalkulators/.
 * The EN page keeps the LV slug so Seo.astro's mechanical /en+path hreflang
 * mapping resolves (same convention as /en/par-taupi/).
 */
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import BudgetCalculator, { LINE_COLORS } from "~/components/calculator/BudgetCalculator";
import { getDict } from "~/i18n/strings";
import type { Locale } from "~/i18n/strings";
import { BENCHMARKS, LINES } from "~/lib/affordability";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const t = getDict(locale);

// Benchmark table rows — straight from the logic file so the SEO text can
// never drift from what the tool actually scores.
const share = (n: number, min: boolean) =>
  (min ? t["bc.table.min"] : t["bc.table.max"]).replace("{n}", String(n));

const rows = LINES.map((k) => {
  const b = BENCHMARKS[k];
  return {
    color: LINE_COLORS[k],
    label: t[`bc.line.${k}`],
    rec: share(b.good, b.higherBetter),
    ok: share(b.amber, b.higherBetter),
  };
});

const legend = [
  { color: "#2DD4A7", label: t["bc.legend.good"] },
  { color: "#FFB547", label: t["bc.legend.amber"] },
  { color: "#FF3B87", label: t["bc.legend.bad"] },
];
---
<Base title={title} description={description} locale={locale}>
  <Nav locale={locale} />

  <main class="pt-32 md:pt-40 pb-8">
    <!-- ── Page header ── -->
    <header class="mx-auto max-w-6xl px-6 md:px-10 mb-10 md:mb-14">
      <p class="eyebrow mb-6">{t["bc.eyebrow"]}</p>
      <h1 class="display-xl text-ink">{t["bc.title"]}</h1>
      <p class="mt-6 text-dim max-w-[56ch] text-lg" style="line-height: 1.65;">
        {t["bc.sub"]}
      </p>
    </header>

    <!-- ── The tool ── -->
    <section class="mx-auto max-w-6xl px-6 md:px-10">
      <BudgetCalculator client:load locale={locale} />
    </section>

    <!-- ── Method + benchmarks (the SEO substance) ── -->
    <section class="mx-auto max-w-3xl px-6 md:px-10 mt-24 md:mt-32">
      <p class="eyebrow mb-5">{t["bc.method.eyebrow"]}</p>
      <h2
        class="font-display font-bold text-ink"
        style="font-size: clamp(24px, 3vw, 36px); letter-spacing: -0.02em; line-height: 1.2;"
      >
        {t["bc.method.title"]}
      </h2>
      <p class="mt-5 text-dim" style="line-height: 1.7;">{t["bc.method.body"]}</p>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {legend.map((l) => (
          <span class="flex items-center gap-2 text-[13px] text-dim">
            <span aria-hidden class="w-2.5 h-2.5 rounded-full" style={`background: ${l.color};`} />
            {l.label}
          </span>
        ))}
      </div>

      <table class="w-full mt-6 border-collapse text-[14px]">
        <thead>
          <tr>
            <th class="text-left font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 pr-3 border-b border-white/10">
              {t["bc.table.category"]}
            </th>
            <th class="text-right font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 px-3 border-b border-white/10">
              {t["bc.table.rec"]}
            </th>
            <th class="text-right font-mono font-medium text-[10px] tracking-[0.16em] uppercase text-muted py-2.5 pl-3 border-b border-white/10">
              {t["bc.table.ok"]}
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="py-3 pr-3 border-b border-white/5 text-ink">
                <span class="flex items-center gap-2.5">
                  <span aria-hidden class="w-2.5 h-2.5 rounded-[4px] shrink-0" style={`background: ${r.color};`} />
                  {r.label}
                </span>
              </td>
              <td class="py-3 px-3 border-b border-white/5 text-right font-mono text-dim tabular-nums">{r.rec}</td>
              <td class="py-3 pl-3 border-b border-white/5 text-right font-mono text-muted tabular-nums">{r.ok}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Bridge to the app: on web you type the numbers, in the app they come
           from your real spending. -->
      <p
        class="mt-10 px-5 py-4 rounded-xl text-[15px] text-ink"
        style="background: rgba(90, 107, 255, 0.08); border: 1px solid rgba(90, 107, 255, 0.25); line-height: 1.6;"
      >
        {t["bc.app.note"]}
      </p>
    </section>
  </main>

  <DownloadCTA locale={locale} />
  <Footer locale={locale} />
</Base>
