---
/**
 * The /kalkulatori/ hub — bento režģis vienotajā karšu stilā: klusa virsma
 * un liela balta ghost ikona fonā (tas pats raksts, kas sākumlapas Iespēju
 * sekcijai un gids kartēm). Ekrānuzņēmumu foni izmesti (2026-09-18) — tie
 * neko neizteica un konfliktēja ar pārējo karšu valodu.
 */
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import ToolGhostIcon from "~/components/ToolGhostIcon.astro";
import { getDict } from "~/i18n/strings";
import type { Locale } from "~/i18n/strings";
import { path } from "~/i18n/routes";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const t = getDict(locale);

// `lvOnly` tools are dropped from the EN hub — routes.percent.en is null, so
// `path()` would silently fall back to the Latvian page and hand an English
// reader a Latvian one.
const tools = [
  { key: "budget", href: path("budget", locale), span: "md:col-span-3" },
  { key: "percent", href: path("percent", locale), span: "md:col-span-3", lvOnly: true },
  { key: "compound", href: path("compound", locale), span: "md:col-span-2" },
  { key: "emergency", href: path("emergency", locale), span: "md:col-span-2" },
  { key: "debt", href: path("debt", locale), span: "md:col-span-2" },
]
  .filter((tool) => locale === "lv" || !tool.lvOnly)
  // EN hub ir 4 rīki (percent ir lv-only) — bento 3+2+2+2 tur atstātu robu,
  // tāpēc bez piektā visi stājas 2×2 režģī.
  .map((tool, _i, arr) => (arr.length === 4 ? { ...tool, span: "md:col-span-3" } : tool));
---
<Base
  title={title}
  description={description}
  locale={locale}
  ogImage={`/og/tools${locale === "en" ? "-en" : ""}.jpg`}
  breadcrumbs={[{ name: t["tools.title"], href: path("tools", locale) }]}
>
  <Nav locale={locale} />

  <main class="relative pt-32 md:pt-40 pb-8">
    {/* Kluss brand mirdzums aiz galvenes — kā pārējās satura lapās. */}
    <div
      aria-hidden
      class="pointer-events-none absolute top-16 left-1/2 h-[480px] w-full max-w-[1100px] -translate-x-1/2"
      style="background: radial-gradient(closest-side, rgba(90,107,255,0.12) 0%, rgb(var(--bg-rgb) / 0) 100%);"
    >
    </div>
    <header class="relative mx-auto max-w-content px-6 md:px-10 mb-12 md:mb-16">
      <p class="eyebrow mb-6">{t["tools.eyebrow"]}</p>
      <h1 class="display-xl text-ink">{t["tools.title"]}</h1>
      <p class="mt-6 text-dim max-w-[56ch] text-lg" style="line-height: 1.65;">
        {t["tools.sub"]}
      </p>
    </header>

    <section class="mx-auto max-w-content px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class={`${tool.span} group relative overflow-hidden rounded-2xl border border-frost/10 bg-frost/[0.03] p-7 hover:border-accent/15 hover:bg-frost/[0.05] transition-colors min-h-[210px] flex flex-col justify-end`}
          >
            {/* Ghost ikona fonā — vienotais karšu raksts. */}
            <ToolGhostIcon tool={tool.key} size={220} class="-right-10 -top-10" />

            <div class="relative">
              <p
                class="font-display font-bold text-ink text-[20px] group-hover:text-accent transition-colors"
                style="letter-spacing: -0.015em; line-height: 1.25;"
              >
                {t[`tools.${tool.key}.title`]}
              </p>
              <p class="mt-2.5 text-[14px] text-dim" style="line-height: 1.55;">
                {t[`tools.${tool.key}.desc`]}
              </p>
              <p class="mt-5 eyebrow text-accent">
                {t["tools.open"]}
                <span class="inline-block ml-1 transition-transform group-hover:translate-x-1" aria-hidden>→</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <DownloadCTA locale={locale} />
  <Footer locale={locale} />
</Base>
