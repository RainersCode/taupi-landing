---
/**
 * The /kalkulatori/ hub — every tool as a card with a small hand-drawn
 * mini-visual (the tool's signature element in miniature): stacked bar,
 * rising curve, progress ring, shrinking debt bars.
 */
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import { getDict } from "~/i18n/strings";
import type { Locale } from "~/i18n/strings";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const t = getDict(locale);
const prefix = locale === "lv" ? "" : "/en";

const tools = [
  {
    key: "budget",
    href: `${prefix}/budzeta-kalkulators/`,
    viz: "budget",
  },
  {
    key: "compound",
    href: `${prefix}/salikto-procentu-kalkulators/`,
    viz: "compound",
  },
  {
    key: "emergency",
    href: `${prefix}/drosibas-spilvena-kalkulators/`,
    viz: "emergency",
  },
  {
    key: "debt",
    href: `${prefix}/kreditu-atmaksas-kalkulators/`,
    viz: "debt",
  },
];
---
<Base title={title} description={description} locale={locale}>
  <Nav locale={locale} />

  <main class="pt-32 md:pt-40 pb-8">
    <header class="mx-auto max-w-5xl px-6 md:px-10 mb-12 md:mb-16">
      <p class="eyebrow mb-6">{t["tools.eyebrow"]}</p>
      <h1 class="display-xl text-ink">{t["tools.title"]}</h1>
      <p class="mt-6 text-dim max-w-[56ch] text-lg" style="line-height: 1.65;">
        {t["tools.sub"]}
      </p>
    </header>

    <section class="mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group block rounded-3xl p-7 bg-white/[0.04] border border-white/10 hover:border-accent/40 transition-colors"
          >
            <div class="flex items-center justify-between gap-4 mb-6">
              {/* Mini-visual — the tool's signature element in miniature */}
              {tool.viz === "budget" && (
                <svg width="64" height="36" viewBox="0 0 64 36" fill="none" aria-hidden="true">
                  <rect x="0" y="14" width="18" height="8" rx="2" fill="#7C8CFF" />
                  <rect x="20" y="14" width="12" height="8" rx="2" fill="#4FC3F7" />
                  <rect x="34" y="14" width="10" height="8" rx="2" fill="#81C784" />
                  <rect x="46" y="14" width="8" height="8" rx="2" fill="#34D399" />
                  <rect x="56" y="14" width="8" height="8" rx="2" fill="rgba(255,255,255,0.14)" />
                </svg>
              )}
              {tool.viz === "compound" && (
                <svg width="64" height="36" viewBox="0 0 64 36" fill="none" aria-hidden="true">
                  <path
                    d="M2 32 C 20 30, 34 26, 44 18 S 58 6, 62 3"
                    stroke="#2DD4A7"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                  <path d="M2 32 H 62" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" stroke-linecap="round" />
                  <circle cx="62" cy="3" r="3" fill="#2DD4A7" />
                </svg>
              )}
              {tool.viz === "emergency" && (
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                  <circle cx="20" cy="20" r="15" stroke="rgba(255,255,255,0.12)" stroke-width="5" />
                  <circle
                    cx="20"
                    cy="20"
                    r="15"
                    stroke="#38BDF8"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-dasharray="94.2"
                    stroke-dashoffset="31.4"
                    transform="rotate(-90 20 20)"
                  />
                </svg>
              )}
              {tool.viz === "debt" && (
                <svg width="64" height="36" viewBox="0 0 64 36" fill="none" aria-hidden="true">
                  <rect x="2" y="4" width="10" height="30" rx="2" fill="#FF8A80" />
                  <rect x="16" y="12" width="10" height="22" rx="2" fill="#FF8A80" opacity="0.75" />
                  <rect x="30" y="20" width="10" height="14" rx="2" fill="#FF8A80" opacity="0.5" />
                  <rect x="44" y="27" width="10" height="7" rx="2" fill="#FF8A80" opacity="0.3" />
                  <path d="M56 31 l2.5 2.5 L64 26" stroke="#2DD4A7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
              )}
              <span class="eyebrow text-muted">{t[`tools.${tool.key}.tag`]}</span>
            </div>

            <p
              class="font-display font-bold text-ink text-[20px] group-hover:text-accent transition-colors"
              style="letter-spacing: -0.015em; line-height: 1.25;"
            >
              {t[`tools.${tool.key}.title`]}
            </p>
            <p class="mt-2.5 text-[14px] text-dim" style="line-height: 1.55;">
              {t[`tools.${tool.key}.desc`]}
            </p>
            <p class="mt-5 eyebrow text-accent">
              {t["tools.open"]}
              <span class="inline-block ml-1 transition-transform group-hover:translate-x-1" aria-hidden>→</span>
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <DownloadCTA locale={locale} />
  <Footer locale={locale} />
</Base>
