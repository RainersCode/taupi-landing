---
/**
 * The /kalkulatori/ hub — every tool as a card with a Lucide icon in a
 * tinted tile (same icon language as the app's own calculator hub) plus
 * title, description and CTA.
 */
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import DownloadCTA from "~/components/DownloadCTA.astro";
import { ChartPie, TrendingUp, ShieldCheck, Layers } from "@lucide/astro";
import { getDict } from "~/i18n/strings";
import type { Locale } from "~/i18n/strings";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const t = getDict(locale);
const prefix = locale === "lv" ? "" : "/en";

// Icons mirror the app's CalculatorsHubScreen (pie-chart / trending-up /
// shield-checkmark / layers); accents are each tool's signature color.
const tools = [
  {
    key: "budget",
    href: `${prefix}/budzeta-kalkulators/`,
    icon: ChartPie,
    accent: "#7C8CFF",
  },
  {
    key: "compound",
    href: `${prefix}/salikto-procentu-kalkulators/`,
    icon: TrendingUp,
    accent: "#2DD4A7",
  },
  {
    key: "emergency",
    href: `${prefix}/drosibas-spilvena-kalkulators/`,
    icon: ShieldCheck,
    accent: "#38BDF8",
  },
  {
    key: "debt",
    href: `${prefix}/kreditu-atmaksas-kalkulators/`,
    icon: Layers,
    accent: "#FF8A80",
  },
];
---
<Base title={title} description={description} locale={locale}>
  <Nav locale={locale} />

  <main class="pt-32 md:pt-40 pb-8">
    <header class="mx-auto max-w-5xl px-6 md:px-10 mb-12 md:mb-16">
      <p class="eyebrow mb-6">{t["tools.eyebrow"]}</p>
      <h1 class="display-xl text-ink">{t["tools.title"]}</h1>
      <p class="mt-6 text-dim max-w-[56ch] text-lg" style="line-height: 1.65;">
        {t["tools.sub"]}
      </p>
    </header>

    <section class="mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group block rounded-3xl p-7 bg-white/[0.04] border border-white/10 hover:border-accent/40 transition-colors"
          >
            <div class="flex items-center justify-between gap-4 mb-7">
              <span
                class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0"
                style={`background: ${tool.accent}1a; border: 1px solid ${tool.accent}40;`}
              >
                <tool.icon size={22} color={tool.accent} stroke-width={1.8} aria-hidden="true" />
              </span>
              <span class="eyebrow text-muted">{t[`tools.${tool.key}.tag`]}</span>
            </div>

            <p
              class="font-display font-bold text-ink text-[20px] group-hover:text-accent transition-colors"
              style="letter-spacing: -0.015em; line-height: 1.25;"
            >
              {t[`tools.${tool.key}.title`]}
            </p>
            <p class="mt-2.5 text-[14px] text-dim" style="line-height: 1.55;">
              {t[`tools.${tool.key}.desc`]}
            </p>
            <p class="mt-5 eyebrow text-accent">
              {t["tools.open"]}
              <span class="inline-block ml-1 transition-transform group-hover:translate-x-1" aria-hidden>→</span>
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <DownloadCTA locale={locale} />
  <Footer locale={locale} />
</Base>
